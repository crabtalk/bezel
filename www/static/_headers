# SvelteKit content-hashes everything under here, so the URL changes whenever
# the bytes do and the cache never needs to ask.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed by scripts/hash-gallery.js.
/gallery/web*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed, and names the hashed files.
/gallery/
  Cache-Control: public, max-age=300
