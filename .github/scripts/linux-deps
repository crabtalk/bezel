#!/usr/bin/env bash
# Native Linux builds require WPE WebKit 2.54+ with WPEPlatform.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    libfontconfig-dev \
    libwayland-dev \
    libx11-xcb-dev \
    libxkbcommon-x11-dev \
    libwpewebkit-2.0-dev \
    libjson-glib-dev \
    libgbm-dev \
    libegl-dev \
    libgles-dev
pkg-config --print-errors --exists \
    'wpe-webkit-2.0 >= 2.54' wpe-platform-2.0 \
    json-glib-1.0 gbm egl glesv2 xkbcommon
